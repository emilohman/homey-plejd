            "prev": "site",
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ]
    },
    {
      "id": "thermostat",
      "name": {
        "en": "Plejd thermostat"
      },
      "class": "thermostat",
      "capabilities": [
        "target_temperature",
        "measure_temperature",
        "onoff",
        "measure_power"
      ],
      "images": {
        "large": "/drivers/thermostat/assets/images/large.png",
        "small": "/drivers/thermostat/assets/images/small.png"
      },
      "pair": [
        {
          "id": "login",
          "template": "login_credentials",
          "options": {
            "logo": "../../../assets/images/large.png"
          }
        },
        {
          "id": "site",
          "navigation": {
            "prev": "login"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "prev": "site",
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "heater_power",
          "type": "number",
          "label": {
            "en": "Heater power (W)",
            "no": "Varmeeffekt (W)"
          },
          "hint": {
            "en": "Rated power of the connected heater. Reported as measure_power while the thermostat is heating.",
            "no": "Merkeeffekt på varmekabelen. Rapporteres som effekt mens termostaten varmer."
          },
          "value": 700,
          "min": 0,
          "max": 5000,
          "units": {
            "en": "W"
          }
        }
      ]
    }
  ],
  "flow": {
    "triggers": [
      {
        "id": "button_pressed",
        "title": {
          "en": "A button has been pressed"
        },
        "tokens": [
          {
            "name": "button",
            "type": "number",
            "title": {
              "en": "Button"
            },
            "example": 2
          }
        ],
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=button"
          }
        ]
      },
      {
        "id": "button_pressed2",
        "title": {
          "en": "Button ... has been pressed"
        },
        "titleFormatted": {
          "en": "Button [[button]] has been pressed"
        },
        "args": [
          {
            "type": "dropdown",
            "name": "button",
            "title": {
              "en": "Button number"
            },
            "values": [
              {
                "id": "1",
                "label": {
                  "en": "Left up"
                }
              },
              {
                "id": "3",
                "label": {
                  "en": "Left down"
                }
              },
              {
                "id": "2",
                "label": {
                  "en": "Right up"
                }
              },
              {
                "id": "4",
                "label": {
                  "en": "Right down"
                }
              }
            ]
          },
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=button"
          }
        ]
      },
      {
        "id": "scene_triggered",
        "title": {
          "en": "Scene ... has been triggered"
        },
        "titleFormatted": {
          "en": "Scene [[scene]] has been triggered"
        },
        "args": [
          {
            "type": "autocomplete",
            "name": "scene",
            "title": {
              "en": "Select scene"
            }
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "dim_over_time",
        "title": {
          "en": "Dim from ... to ... over ... seconds"
        },
        "titleFormatted": {
          "en": "Dim [[brightness_from]] to [[brightness_to]] over [[seconds]] seconds"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=plejd"
          },
          {
            "name": "brightness_from",
            "type": "range",
            "title": {
              "en": "Brightness from"
            },
            "label": "%",
            "labelMultiplier": 100,
            "min": 0,
            "max": 1,
            "step": 0.01
          },
          {
            "name": "brightness_to",
            "type": "range",
            "title": {
              "en": "Brightness to"
            },
            "label": "%",
            "labelMultiplier": 100,
            "min": 0,
            "max": 1,
            "step": 0.01
          },
          {
            "name": "seconds",
            "type": "number",
            "title": {
              "en": "Time"
            },
            "label": "s",
            "min": 1,
            "max": 600,
            "step": 1
          }
        ]
      }
    ]
  }
}
