{
  "id": "se.emilohman.plejd",
  "version": "3.5.4",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "brandColor": "#48c5d6",
  "name": {
    "en": "Plejd"
  },
  "description": {
    "en": "Smart lighting for everyone"
  },
  "tags": {
    "en": [
      "plejd, light, bluetooth, BLE, dimmer"
    ]
  },
  "category": [
    "lights"
  ],
  "permissions": [
    "homey:wireless:ble"
  ],
  "images": {
    "large": "/assets/images/large.png",
    "small": "/assets/images/small.png"
  },
  "author": {
    "name": "Emil Öhman",
    "email": "emilohman@gmail.com"
  },
  "contributors": {
    "developers": [
      {
        "name": "Emil Öhman",
        "email": "emilohman@gmail.com"
      }
    ]
  },
  "contributing": {
    "donate": {
      "paypal": {
        "username": "emilohman2"
      }
    }
  },
  "bugs": {
    "url": "https://github.com/emilohman/homey-plejd/issues"
  },
  "source": "https://github.com/emilohman/homey-plejd",
  "homeyCommunityTopicId": 43266,
  "drivers": [
    {
      "id": "plejd",
      "name": {
        "en": "Plejd"
      },
      "class": "light",
      "capabilities": [
        "dim",
        "onoff"
      ],
      "images": {
        "large": "/drivers/plejd/assets/images/large.png",
        "small": "/drivers/plejd/assets/images/small.png"
      },
      "pair": [
        {
          "id": "login",
          "template": "login_credentials",
          "options": {
            "logo": "../../../assets/images/large.png"
          }
        },
        {
          "id": "site",
          "navigation": {
            "prev": "login"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "prev": "site",
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "device_class",
          "type": "dropdown",
          "value": "light",
          "label": {
            "en": "Device class"
          },
          "values": [
            {
              "id": "light",
              "label": {
                "en": "Light"
              }
            },
            {
              "id": "socket",
              "label": {
                "en": "Socket"
              }
            }
          ]
        },
        {
          "id": "dimmable",
          "type": "checkbox",
          "value": true,
          "label": {
            "en": "Dimmable"
          }
        },
        {
          "id": "color_temperature",
          "type": "checkbox",
          "value": false,
          "label": {
            "en": "Color temperature"
          }
        }
      ]
    },
    {
      "id": "room",
      "name": {
        "en": "Plejd room"
      },
      "class": "light",
      "capabilities": [
        "onoff",
        "dim"
      ],
      "images": {
        "large": "/drivers/room/assets/images/large.png",
        "small": "/drivers/room/assets/images/small.png"
      },
      "pair": [
        {
          "id": "login",
