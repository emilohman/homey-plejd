          "options": {
            "logo": "../../../assets/images/large.png"
          }
        },
        {
          "id": "site",
          "navigation": {
            "prev": "login"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "prev": "site",
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ]
    },
    {
      "id": "button",
      "name": {
        "en": "Plejd button"
      },
      "class": "button",
      "capabilities": [],
      "images": {
        "large": "/drivers/button/assets/images/large.png",
        "small": "/drivers/button/assets/images/small.png"
      },
      "pair": [
        {
          "id": "login",
          "template": "login_credentials",
          "options": {
            "logo": "../../../assets/images/large.png"
          }
        },
        {
          "id": "site",
          "navigation": {
            "prev": "login"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "prev": "site",
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ]
    },
    {
      "id": "motion",
      "name": {
        "en": "Plejd motion sensor"
      },
      "class": "sensor",
      "capabilities": [
        "alarm_motion"
      ],
      "images": {
        "large": "/drivers/motion/assets/images/large.png",
        "small": "/drivers/motion/assets/images/small.png"
      },
      "pair": [
        {
          "id": "login",
          "template": "login_credentials",
          "options": {
            "logo": "../../../assets/images/large.png"
          }
        },
        {
          "id": "site",
          "navigation": {
            "prev": "login"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "prev": "site",
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ]
    },
    {
      "id": "cover",
      "name": {
        "en": "Plejd cover"
      },
      "class": "curtain",
      "capabilities": [
        "windowcoverings_set"
      ],
      "images": {
        "large": "/drivers/cover/assets/images/large.png",
        "small": "/drivers/cover/assets/images/small.png"
      },
      "pair": [
        {
          "id": "login",
          "template": "login_credentials",
          "options": {
            "logo": "../../../assets/images/large.png"
          }
        },
        {
          "id": "site",
          "navigation": {
            "prev": "login"
          }
        },
        {
          "id": "list_devices",
          "template": "list_devices",
